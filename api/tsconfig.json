{
  "compilerOptions": {
    /* Configurações de Módulos */
    "target": "es2016",
    "module": "commonjs",             /* <--- Importante: Traduz imports para require */
    "moduleResolution": "node",       /* <--- Importante: Ajuda a achar os pacotes */
    "esModuleInterop": true,          /* <--- Importante: Permite importar express desse jeito */
    "verbatimModuleSyntax": false,    /* <--- A SOLUÇÃO: Desliga a regra estrita que causou o erro */
    
    /* Configurações de Saída */
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}